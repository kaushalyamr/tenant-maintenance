# ---------------------------------------------------------------------------
# Every setting the system reads. Copy to .env and fill in real values.
# Never commit a populated .env — JWT_SECRET and MONGODB_URI are credentials.
# ---------------------------------------------------------------------------

# Express API
PORT=4000

# MongoDB connection string. Local service on the default port looks like this.
MONGODB_URI=mongodb://127.0.0.1:27017/tenant_maintenance

# Signs session JWTs. Generate a fresh 32+ byte random value per environment.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12

# Set to true only when the app is served over HTTPS; controls the cookie's
# Secure flag so the session token is never sent in cleartext.
COOKIE_SECURE=false

# Origin allowed to send credentialed requests (the Next.js app).
WEB_ORIGIN=http://localhost:3000

# Where uploaded evidence (photos, video frames) is kept, and its size cap.
# disk  = write files under EVIDENCE_DIR (a normal server)
# mongo = store the bytes in MongoDB; required on serverless hosts, which have
#         no persistent disk. Vercel defaults to mongo automatically.
EVIDENCE_STORAGE=disk
EVIDENCE_DIR=./storage/evidence
EVIDENCE_MAX_BYTES=15728640

# Which triage ruleset version new cases are scored with. Rulesets are
# append-only so historical cases keep the version that decided them.
TRIAGE_VERSION=triage-v1

# Confidence below which a case is handed to a human instead of auto-dispatched.
TRIAGE_ESCALATION_THRESHOLD=0.6

# Frontend: where the browser calls the API. Leave empty in production when the
# Next.js app proxies /api to the API deployment (API_PROXY_TARGET).
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Frontend build setting, production only: the API origin that next.config.mjs
# proxies /api/* to. Not exposed to the browser.
API_PROXY_TARGET=

# Seed script only. Not a real credential.
SEED_PASSWORD=tenant1234
